{
  "name": "mcpscan",
  "version": "0.2.0",
  "description": "Static scanner for malicious MCP config files in AI-integrated editor repos",
  "type": "module",
  "bin": {
    "mcpscan": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "security",
    "scanner",
    "static-analysis",
    "supply-chain",
    "ai",
    "claude",
    "cursor",
    "vscode"
  ],
  "dependencies": {
    "commander": "^12.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "overrides": {
    "nanoid": "3.3.18"
  }
}
